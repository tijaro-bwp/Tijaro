# Copy to .env for local development. On Vercel, set these per project
# (Project Settings -> Environment Variables). Never put the service-role key in a VITE_* variable:
# it is bundled into the browser. Privileged work goes through supabase/functions/admin-api.

# Supabase project (Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: email API (api-server.js) and its Resend key (server-side only, not VITE_)
VITE_EMAIL_API_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional white-label branding (defaults are EdgeX values; see src/config/brand.js)
VITE_BRAND_APP_NAME=
VITE_BRAND_APP_FULL_NAME=
VITE_BRAND_SHORT_NAME=
VITE_BRAND_TAGLINE=
VITE_BRAND_COMPANY=
VITE_BRAND_CREDIT=
VITE_BRAND_SUPPORT_NAME=
VITE_BRAND_SUPPORT_PHONE=
VITE_BRAND_LOGO=
VITE_BRAND_ICON=
VITE_BRAND_THEME_COLOR=
